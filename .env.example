# Copy to .env and fill in real values. .env is gitignored and must never be committed.

# Signing key for the JWTs issued at /login.
# Generate a fresh one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# SQLAlchemy database URL.
# Local development:  sqlite:///database.db
# Production:         postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///database.db
